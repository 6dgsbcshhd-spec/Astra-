import { useEffect, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { api } from '../lib/api';

export default function Chats() {
  const nav = useNavigate();
  const [chats, setChats] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    api('GET', '/chats')
      .then((res) => setChats(res.chats))
      .catch(() => {
        // Если токен протух, кидаем на вход
        localStorage.removeItem('token');
        nav('/auth');
      })
      .finally(() => setLoading(false));
  }, [nav]);

  const logout = () => {
    localStorage.removeItem('token');
    nav('/auth');
  };

  return (
    <div style={{ minHeight: '100vh', background: '#F4F4F5', fontFamily: 'sans-serif' }}>
      {/* Шапка */}
      <header style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '16px', background: 'white', borderBottom: '1px solid #eaeaea' }}>
        <h1 style={{ fontSize: 20, fontWeight: 'bold', margin: 0 }}>Чаты</h1>
        <button onClick={logout} style={{ background: 'none', border: 'none', color: 'red', cursor: 'pointer', fontSize: 14 }}>
          Выйти
        </button>
      </header>

      {/* Список чатов */}
      <div style={{ padding: 16 }}>
        {loading ? (
          <p style={{ textAlign: 'center', color: '#888' }}>Загрузка...</p>
        ) : chats.length === 0 ? (
          <div style={{ textAlign: 'center', marginTop: 50, color: '#888' }}>
            <p>У вас пока нет чатов.</p>
            <button style={{ marginTop: 10, padding: '10px 20px', background: '#1C2B2D', color: 'white', borderRadius: 8, border: 'none' }}>
              Создать чат
            </button>
          </div>
        ) : (
          <ul style={{ listStyle: 'none', padding: 0, margin: 0, background: 'white', borderRadius: 12, overflow: 'hidden' }}>
            {chats.map((c) => (
              <li key={c.id} style={{ padding: '16px', borderBottom: '1px solid #f0f0f0' }}>
                <strong>{c.title || 'Без названия'}</strong>
                <span style={{ color: '#888', fontSize: 12, marginLeft: 10 }}>{c.type}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  );
}
